LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
# NVIDIA NIM, set LLM_PROVIDER=nvidia:
NVIDIA_API_KEY=
API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Hosted request/answer safety checks (uses NVIDIA_SAFETY_API_KEY or falls back
# to NVIDIA_API_KEY/API_KEY). Requests and final answers are sent to NVIDIA.
GUARDRAILS_ENABLED=true
NVIDIA_SAFETY_API_KEY=
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
NVIDIA_SAFETY_BASE_URL=https://integrate.api.nvidia.com/v1
MAX_INPUT_CHARS=10000
# For Azure OpenAI, set LLM_PROVIDER=azure and provide these:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
WORKSPACE_ROOT=workspace_data
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
LANGGRAPH_THREAD_ID=default
MAX_TOOL_ROUNDS=4
MAX_REVISIONS=1
LOG_LEVEL=INFO
